# Public site URL, used for canonical links, OG metadata and Supabase redirects.
NEXT_PUBLIC_SITE_URL=https://www.skill-quest.app

# Supabase project. The publishable key is exposed to the browser; the
# service role key is server-only and used by the API routes (subscribe,
# resend-verification, auth confirm) to write with elevated privileges.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Resend, used to send verification and password-reset emails from the API
# routes under src/app/api.
RESEND_API_KEY=your_resend_api_key_here
