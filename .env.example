# Public site URL, used for canonical links, OG metadata and Supabase redirects.
NEXT_PUBLIC_SITE_URL=https://www.skill-quest.app

# Supabase project. The publishable key is exposed to the browser; the
# service role key is server-only and used by the API routes (subscribe,
# feedback, auth confirm) to write with elevated privileges. While
# NEWSLETTER_TOKEN_SECRET is not set, the newsletter links fall back to it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Resend sending-only key for the feedback and password-reset emails sent
# from the API routes under src/app/api.
RESEND_API_KEY=your_resend_api_key_here

# Resend full-access key for the newsletter routes only (subscribe,
# newsletter/confirm, newsletter/unsubscribe): Resend allows managing
# contacts, segments and topics only with full access. See docs/NEWSLETTER.md.
RESEND_NEWSLETTER_API_KEY=your_resend_full_access_key_here

# The newsletter's own secret for its email links (confirmation token,
# unsubscribe signature) and rate-limit hashes. At least 32 random
# characters, e.g. `openssl rand -base64 48`. Server-only; never tied to a
# Supabase key, so moving the database does not break links that are out.
# PREVIOUS is optional: the secret it replaced (at the first switch-over the
# service role key), accepted for a while so older links keep working. Once
# the own secret is set, the service role key alone is no longer accepted.
# See docs/NEWSLETTER.md.
NEWSLETTER_TOKEN_SECRET=your_random_secret_of_at_least_32_characters
# NEWSLETTER_TOKEN_SECRET_PREVIOUS=
